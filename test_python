import asyncio


async def greeting(name, delay):
    await asyncio.sleep(delay)
    return f"hello, {name}"


async def solution():
    messages = await asyncio.gather(
        greeting("Alice", 0.1),
        greeting("Bob", 0.2),
    )
    for message in messages:
        print(message)


if __name__ == "__main__":
    asyncio.run(solution())